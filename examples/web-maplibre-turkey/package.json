{
  "name": "@territory-kit/example-web-maplibre-turkey",
  "version": "0.0.10",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "rimraf dist .turbo",
    "dev": "vite --host 0.0.0.0",
