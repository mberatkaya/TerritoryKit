{
  "name": "@territory-kit/example-web-maplibre-turkey",
  "version": "0.0.13",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "rimraf dist .turbo",
    "dev": "vite --host 127.0.0.1",
    "dev:national-playable": "VITE_TERRITORY_DEMO_MODE=local-playable vite --host 127.0.0.1",
    "perf:budget": "pnpm build && node scripts/performance-budget.mjs",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:local-playable": "PW_LOCAL_PLAYABLE=1 playwright test",
    "test:visual": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@territory-kit/adapter-core": "workspace:*",
    "@territory-kit/core": "workspace:*",
    "@territory-kit/data-tr": "workspace:*",
    "@territory-kit/dataset": "workspace:*",
    "@territory-kit/maplibre": "workspace:*",
    "@territory-kit/registry": "workspace:*",
    "@territory-kit/runtime": "workspace:*",
    "@territory-kit/shared-testkit": "workspace:*",
    "maplibre-gl": "^6.14.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.10"
  }
}
